<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
<parent><groupId>org.antchainbridge.experiment</groupId><artifactId>paper-experiment</artifactId><version>1.0-SNAPSHOT</version></parent>
<artifactId>paper-experiment-runner</artifactId><dependencies>
<dependency><groupId>org.antchainbridge.experiment</groupId><artifactId>paper-experiment-ethereum-adapter</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>org.antchainbridge.experiment</groupId><artifactId>paper-experiment-mychain-adapter</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>org.antchainbridge.experiment</groupId><artifactId>paper-experiment-fisco-adapter</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
</dependencies>
<build><plugins>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.5.0</version>
<executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
<createDependencyReducedPom>false</createDependencyReducedPom><shadedArtifactAttached>true</shadedArtifactAttached><shadedClassifierName>all</shadedClassifierName>
<filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.EC</exclude></excludes></filter></filters>
<transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>org.antchainbridge.experiment.ExperimentCli</mainClass></transformer></transformers>
</configuration></execution></executions></plugin>
</plugins></build></project>